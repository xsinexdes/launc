{
  "name": "launcher",
  "version": "1.0.0",
  "description": "Launcher de Minecraft 1.21.1 con actualizaciones automáticas",
  "main": "main.js",
  "author": "Tu servidor",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable nsis --x64 --publish never"
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.servidor.launcher",
    "productName": "Nova Launcher",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "launcher.config.json", "src/**", "renderer/**", "build/icon.png"],
    "win": { "target": ["portable", "nsis"], "icon": "build/icon.ico" },
    "portable": { "artifactName": "NovaLauncher-portable.exe" },
    "nsis": { "oneClick": true, "perMachine": false, "artifactName": "NovaLauncher-instalador.exe" }
  }
}
